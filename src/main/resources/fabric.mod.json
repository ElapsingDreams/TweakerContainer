{
  "schemaVersion": 1,
  "id": "tweakercontainer",
  "version": "${version}",
  "name": "TweakerContainer",
  "description": "TweakerContainer - 按投影清单清点材料，高亮容器与缺料槽位",
  "authors": [
    "YiReve"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/tweakercontainer/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "cn.yireve.tweakercontainer.TweakerContainer"
    ],
    "client": [
      "cn.yireve.tweakercontainer.client.TweakerContainerClient"
    ]
  },
  "mixins": [
    "tweakercontainer.mixins.json",
    {
      "config": "tweakercontainer.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft_dependency}",
    "malilib": "${malilib_dependency}",
    "litematica": "${litematica_dependency}"
  }
}
